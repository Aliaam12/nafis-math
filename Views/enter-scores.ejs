<%- include('layout', { body: `
    <div class="table-container" style="max-width: 700px; margin: 0 auto;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-success">✍️ رصد درجات: \${test.test_name}</h4>
            <a href="/admin" class="btn btn-sm btn-secondary">العودة للوحة التحكم</a>
        </div>
        <form action="/admin/test/scores/\${test.id}" method="POST">
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center">
                    <thead class="table-light"><tr><th>الفصل</th><th>اسم الطالبة</th><th style="width: 150px;">الدرجة</th></tr></thead>
                    <tbody>
                        \${students.map(s => \`
                            <tr>
                                <td><span class="badge bg-secondary">فصل \${s.class}</span></td>
                                <td class="text-start fw-bold">\${s.name}</td>
                                <td><input type="number" step="0.01" min="0" max="100" name="scores[\${s.id}]" class="form-control text-center" value="\${s.score !== null ? s.score : ''}" placeholder="غائبة"></td>
                            </tr>
                        \`).join('')}
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fs-5 mt-3">💾 حفظ وتحديث الترتيب تلقائياً</button>
        </form>
    </div>
` }) %>
