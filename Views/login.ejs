<%- include('layout', { body: `
    <div class="table-container shadow mx-auto mt-5" style="max-width: 450px;">
        <h4 class="fw-bold text-center text-primary mb-4">🔐 تسجيل الدخول لبوابة المعلمة</h4>
        \${error ? \`<div class="alert alert-danger text-center py-2">\${error}</div>\` : ''}
        <form action="/login" method="POST">
            <div class="mb-4">
                <label class="form-label fw-bold">كلمة المرور الخاصة بالمعلمة:</label>
                <input type="password" name="password" class="form-control text-center fs-5" placeholder="••••••••" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fs-5 fw-bold">دخول 🔑</button>
        </form>
    </div>
` }) %>
